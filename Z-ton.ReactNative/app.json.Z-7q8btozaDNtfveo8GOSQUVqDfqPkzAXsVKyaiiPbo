{
  "expo": {
    "name": "Z-ton Bank",
    "slug": "Z-ton X-L",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon1.jpg",
    "scheme": "ztonbankingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2937",
        "foregroundImage": "./assets/images/app-icon.jpg",
        "backgroundImage": "./assets/images/app-icon.jpg",
        "monochromeImage": "./assets/images/app-icon.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19250f8b-61bc-44fd-8458-658579814bd9"
      }
    },
    "owner": "dev_adams"
  }
}
